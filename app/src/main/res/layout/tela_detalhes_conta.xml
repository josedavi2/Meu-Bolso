<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/mb_bg" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="Detalhes da conta" android:textColor="@color/mb_ink" android:textSize="28sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bolso_cartao" android:padding="16dp" android:layout_marginBottom="12dp">
      <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/descricao" android:hint="Descrição" android:inputType="textCapSentences" android:minHeight="52dp" />
      <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/valor" android:hint="Valor previsto (R$)" android:inputType="numberDecimal" android:minHeight="52dp" />
      <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/dia" android:hint="Dia do vencimento" android:inputType="number" android:minHeight="52dp" />
      <Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/categoria" android:contentDescription="Categoria" />
      <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/salvar" android:text="Salvar conta" android:textAllCaps="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bolso_cartao" android:padding="16dp" android:layout_marginBottom="12dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/situacao" android:textSize="18sp" android:textColor="@color/mb_ink" />
      <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/pagar" android:text="Já paguei" android:textAllCaps="false" />
      <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/pendente" android:text="Ainda não paguei" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/mb_action" />
      <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/desfazer" android:text="Desfazer pagamento" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/mb_action" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:id="@+id/parcelas" android:textSize="18sp" android:textColor="@color/mb_ink" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
